getwd()
# Load the packages used in the Module 2 readings
library(dplyr)
library(ggplot2)
# Read the analysis dataset
gas <- read.csv("../../../data/gas-prices-states-original.csv.")
# Set the working directory to the repository root for the data path below
knitr::opts_knit$set(root.dir = normalizePath(file.path(dirname(knitr::current_input()), "..", "..", "..")))
# Load data-analysis and plotting packages
library(dplyr)
library(ggplot2)
# Read the analysis dataset
gas <- read.csv("data/gas-prices-states.csv")
# Read the analysis dataset
gas <- read.csv("../../../data/gas-prices-states-original.csv")
# Read the analysis dataset
gas <- read.csv("../../../data/gas-prices-states-original.csv")
# Count observations and calculate proportions by region
gas %>%
count(region) %>%
mutate(proportion = n / sum(n))
# Count observations and calculate proportions by party
gas %>%
count(party) %>%
mutate(proportion = n / sum(n))
# Summarize the distribution of regular gas prices
gas %>%
summarize(
mean = mean(regular_price),
median = median(regular_price),
q1 = quantile(regular_price, 0.25),
q3 = quantile(regular_price, 0.75),
iqr = IQR(regular_price),
sd = sd(regular_price),
min = min(regular_price),
max = max(regular_price)
)
# Bar chart of the region categories
ggplot(gas, aes(x = region)) +
geom_bar(fill = "steelblue") +
labs(
title = "Jurisdictions by region",
x = "Region",
y = "Number of jurisdictions"
) +
theme_minimal()
